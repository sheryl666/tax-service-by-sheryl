.tabbar { position: fixed; z-index: 100; right: 0; bottom: 0; left: 0; min-height: calc(152rpx + env(safe-area-inset-bottom)); display: flex; box-sizing: border-box; padding: 14rpx 16rpx env(safe-area-inset-bottom); border-top: 1rpx solid rgba(214,223,234,.9); background: #fff; box-shadow: 0 -16rpx 48rpx rgba(31,57,90,.07); }
.tab { position: relative; min-width: 0; flex: 1; min-height: 120rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6rpx; border-radius: 24rpx; color: #7b8799; font-size: 24rpx; font-weight: 700; }
.tab.active { color: #123a70; background: #eaf2ff; }
.tab.active::after { position: absolute; top: 8rpx; width: 36rpx; height: 6rpx; border-radius: 8rpx; background: #123a70; content: ''; }
.tab-icon { width: 46rpx; height: 46rpx; flex: 0 0 auto; }
