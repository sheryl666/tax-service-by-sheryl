<view class="topbar" style="padding-top: {{statusBarHeight}}px;">
  <view class="brand-row" style="padding-right: {{capsulePaddingRight}}px;">
    <view class="brand-lockup">
      <view class="brand-mark"><image class="brand-icon" src="data:image/svg+xml;base64," mode="aspectFit" /></view>
      <view><text class="brand-name">名企服务</text><text class="brand-caption">企业认证服务助手</text></view>
    </view>
    <view class="secure-pill" role="button" bindtap="openPrivacyPolicy" aria-label="查看隐私政策"><image class="secure-icon" src="data:image/svg+xml;base64," mode="aspectFit" />信息加密</view>
  </view>
</view>
<view class="page">

  <view class="hero">
    <view class="hero-eyebrow"><image src="data:image/svg+xml;base64," mode="aspectFit" /><text>专业一站式企业服务</text></view>
    <text class="hero-title">个人工商服务助手</text>
    <text class="hero-copy">工商信息公开核验，专属顾问全程协助，让企业服务更清楚、更省心。</text>
    <view class="trust-list">
      <view><image src="data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSI5NiIgaGVpZ2h0PSI5NiIgdmlld0JveD0iMCAwIDI0IDI0IiBmaWxsPSJub25lIiBzdHJva2U9IiM3MGUwY2EiIHN0cm9rZS13aWR0aD0iMS44IiBzdHJva2UtbGluZWNhcD0icm91bmQiIHN0cm9rZS1saW5lam9pbj0icm91bmQiPgogIDxwYXRoIGQ9Im01IDEyIDQgNEwxOSA2Ii8+Cjwvc3ZnPgo=" mode="aspectFit" /><text>官方数据核验</text></view>
      <view><image src="data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSI5NiIgaGVpZ2h0PSI5NiIgdmlld0JveD0iMCAwIDI0IDI0IiBmaWxsPSJub25lIiBzdHJva2U9IiM3MGUwY2EiIHN0cm9rZS13aWR0aD0iMS44IiBzdHJva2UtbGluZWNhcD0icm91bmQiIHN0cm9rZS1saW5lam9pbj0icm91bmQiPgogIDxwYXRoIGQ9Im01IDEyIDQgNEwxOSA2Ii8+Cjwvc3ZnPgo=" mode="aspectFit" /><text>全程专人协助</text></view>
      <view><image src="data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSI5NiIgaGVpZ2h0PSI5NiIgdmlld0JveD0iMCAwIDI0IDI0IiBmaWxsPSJub25lIiBzdHJva2U9IiM3MGUwY2EiIHN0cm9rZS13aWR0aD0iMS44IiBzdHJva2UtbGluZWNhcD0icm91bmQiIHN0cm9rZS1saW5lam9pbj0icm91bmQiPgogIDxwYXRoIGQ9Im01IDEyIDQgNEwxOSA2Ii8+Cjwvc3ZnPgo=" mode="aspectFit" /><text>办理进度可查</text></view>
    </view>
  </view>

  <view class="search-panel">
    <text class="panel-label">企业认证</text>
    <view class="search-box">
      <view class="input-wrap">
        <image class="search-icon" src="data:image/svg+xml;base64," mode="aspectFit" />
        <input value="{{query}}" bindinput="onInput" bindconfirm="searchCompany" confirm-type="search" placeholder="请输入企业名称" maxlength="200" />
        <view wx:if="{{query}}" class="clear-button" role="button" bindtap="clearSearch" aria-label="清空企业名称"><image src="data:image/svg+xml;base64," mode="aspectFit" /></view>
      </view>
      <view class="search-button" role="button" bindtap="searchCompany" aria-label="搜索企业">搜索</view>
    </view>
    <view wx:if="{{error}}" class="error" role="alert">{{error}}</view>
    <view class="search-note"><image src="data:image/svg+xml;base64," mode="aspectFit" /><text>已持续为 <text class="proof-count">10000+</text> 客户服务</text></view>
  </view>

  <view class="service-strip">
    <view class="service-point"><view class="point-mark"><image src="data:image/svg+xml;base64," mode="aspectFit" /></view><view><text class="point-title">快速响应</text><text class="point-copy">需求及时跟进</text></view></view>
    <view class="service-point"><view class="point-mark"><image src="data:image/svg+xml;base64," mode="aspectFit" /></view><view><text class="point-title">专属顾问</text><text class="point-copy">材料全程指导</text></view></view>
    <view class="service-point"><view class="point-mark"><image src="data:image/svg+xml;base64," mode="aspectFit" /></view><view><text class="point-title">安全可靠</text><text class="point-copy">敏感信息保护</text></view></view>
    <view class="service-point"><view class="point-mark"><image src="data:image/svg+xml;base64," mode="aspectFit" /></view><view><text class="point-title">服务专业</text><text class="point-copy">标准流程办理</text></view></view>
  </view>
</view>
