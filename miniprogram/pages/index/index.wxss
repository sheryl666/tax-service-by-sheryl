.detail-nav { position: sticky; z-index: 30; top: 0; border-bottom: 1rpx solid #dfe6ef; background: rgba(255,255,255,.96); }
.detail-nav-inner { position: relative; display: flex; box-sizing: border-box; align-items: center; justify-content: center; }
.back-button { position: absolute; z-index: 2; top: 50%; left: 8rpx; width: 88rpx; height: 88rpx; display: flex; align-items: center; justify-content: center; transform: translateY(-50%); background: transparent; }
.back-button image { width: 44rpx; height: 44rpx; }
.detail-nav-title { position: absolute; left: 50%; color: #172338; font-size: 32rpx; font-weight: 800; line-height: 1; white-space: nowrap; transform: translateX(-50%); pointer-events: none; }
.page { padding: 40rpx 36rpx 236rpx; }
.state-card, .detail-card, .notice, .result-card { border: 1rpx solid #dfe6ef; border-radius: 36rpx; background: #fff; box-shadow: 0 8rpx 32rpx rgba(31,57,90,.07); }
.state-card { padding: 70rpx 30rpx; color: #66748a; text-align: center; }
.detail-card { margin-bottom: 32rpx; padding: 38rpx 36rpx; }
.card-head { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; }
.card-title { color: #172338; font-size: 36rpx; font-weight: 800; }
.status-chip, .test-chip { flex: 0 0 auto; padding: 8rpx 14rpx; border-radius: 999rpx; font-size: 19rpx; font-weight: 700; }
.status-chip { color: #b86c08; background: #fff5df; }
.test-chip { color: #087262; background: #e7f7f3; }
.field { display: block; margin-top: 38rpx; }
.field > text { display: block; margin-bottom: 18rpx; color: #405067; font-size: 28rpx; font-weight: 700; }
.field input, .field textarea { width: 100%; box-sizing: border-box; border: 1rpx solid #cdd7e5; border-radius: 26rpx; color: #172338; background: #fbfcfe; font-size: 30rpx; }
.field input { height: 100rpx; padding: 0 28rpx; }
.field textarea { min-height: 280rpx; padding: 26rpx 28rpx; line-height: 1.6; }
.product-card { overflow: hidden; text-align: left; }
.annual-report-image { width: 100%; display: block; margin-bottom: 32rpx; border-radius: 24rpx; }
.package-list { display: flex; flex-direction: column; align-items: stretch; gap: 18rpx; margin-top: 24rpx; }
.package { width: 100%; min-height: 108rpx; display: flex; align-items: center; justify-content: space-between; box-sizing: border-box; gap: 20rpx; padding: 20rpx 24rpx; border: 2rpx solid #d5deea; border-radius: 24rpx; background: #fbfcfe; text-align: left; }
.package.selected { border-color: #2b78c5; background-color: #eaf2ff; box-shadow: 0 12rpx 26rpx rgba(18,58,112,.1); }
.package.disabled { color: inherit; background: #f4f6f9; opacity: .66; }
.package-info { min-width: 0; flex: 1; text-align: left; }
.product-name { display: block; color: #172338; font-size: 28rpx; font-weight: 800; text-align: left; }
.price { flex: 0 0 auto; color: #123a70; font-size: 42rpx; font-weight: 800; }
.price text { margin-right: 3rpx; font-size: 24rpx; }
.product-description { display: block; margin-top: 20rpx; color: #66748a; font-size: 23rpx; line-height: 1.7; }
.security-note { display: flex; align-items: flex-start; gap: 14rpx; margin: 28rpx 0 20rpx; padding: 20rpx 22rpx; border-radius: 20rpx; color: #53647a; background: #f1fbf8; font-size: 22rpx; line-height: 1.6; }
.security-icon { width: 32rpx; height: 32rpx; flex: 0 0 auto; margin-top: 2rpx; }
.submit-bar { position: fixed; z-index: 20; right: 0; bottom: 0; left: 0; padding: 24rpx 36rpx calc(24rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid #dfe6ef; background: rgba(255,255,255,.96); box-shadow: 0 -20rpx 60rpx rgba(31,57,90,.1); }
.pay-button { height: 104rpx; display: flex; align-items: center; justify-content: center; border-radius: 24rpx; color: #fff; background-color: #123a70; box-shadow: 0 16rpx 40rpx rgba(18,58,112,.2); font-size: 30rpx; font-weight: 800; overflow: hidden; }
.pay-button[disabled] { color: #8b96a7; background-color: #e5e9ef; box-shadow: none; }
.notice, .result-card { margin-top: 20rpx; padding: 28rpx; }
.notice.error { color: #c43b44; border-color: #f0c9cc; background: #fff0f1; font-size: 24rpx; line-height: 1.6; }
.result-card { display: flex; flex-direction: column; }
.result-card.paid { border-color: #cdebe5; background: #f1fbf8; }
.result-title { color: #087262; font-size: 30rpx; font-weight: 800; }
.result-number, .result-tip { margin-top: 12rpx; color: #66748a; font-size: 22rpx; line-height: 1.6; word-break: break-all; }
.records-link { margin: 24rpx 0 0; height: 96rpx; border: 1rpx solid #c8d6e8; border-radius: 24rpx; color: #123a70; background-color: #fff; font-size: 28rpx; font-weight: 800; line-height: 96rpx; overflow: hidden; }
