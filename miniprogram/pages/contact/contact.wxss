.page { width: 100%; overflow-x: hidden; box-sizing: border-box; padding: 40rpx 36rpx 208rpx; }
.page-head { padding: 4rpx 4rpx 40rpx; }
.page-title, .page-copy { display: block; }
.page-title { color: #172338; font-size: 52rpx; font-weight: 800; line-height: 1.3; }
.page-copy { margin-top: 12rpx; color: #66748a; font-size: 28rpx; line-height: 1.6; }
.state-card, .feedback-card { border: 1rpx solid #dfe6ef; border-radius: 28rpx; background: #fff; box-shadow: 0 8rpx 28rpx rgba(31,57,90,.07); }
.state-card { padding: 70rpx 32rpx; color: #66748a; font-size: 24rpx; line-height: 1.6; text-align: center; }
.error-state { color: #c43b44; background: #fff0f1; }
.empty-title, .empty-copy { display: block; }
.empty-title { color: #172338; font-size: 29rpx; font-weight: 800; }
.empty-copy { margin-top: 12rpx; }
.home-button { height: 96rpx; display: flex; align-items: center; justify-content: center; margin-top: 26rpx; border-radius: 24rpx; color: #fff; background: #123a70; font-size: 28rpx; font-weight: 800; }
.feedback-card { padding: 40rpx 36rpx; }
.form-field { margin-bottom: 38rpx; }
.field-label { display: block; margin-bottom: 18rpx; color: #405067; font-size: 28rpx; font-weight: 800; }
.required { color: #c43b44; }
.control, .picker-control, .textarea-wrap textarea { width: 100%; box-sizing: border-box; border: 1rpx solid #cdd7e5; border-radius: 26rpx; color: #172338; background: #fbfcfe; font-size: 30rpx; }
.control, .picker-control { height: 100rpx; padding: 0 28rpx; }
.picker-control { position: relative; overflow: hidden; padding-right: 72rpx; line-height: 100rpx; white-space: nowrap; text-overflow: ellipsis; }
.picker-control.placeholder { color: #98a3b4; }
.picker-arrow { position: absolute; top: 32rpx; right: 24rpx; width: 36rpx; height: 36rpx; }
.textarea-wrap { position: relative; }
.textarea-wrap textarea { min-height: 280rpx; padding: 26rpx 28rpx 62rpx; line-height: 1.6; }
.char-count { position: absolute; right: 20rpx; bottom: 17rpx; color: #8996a9; font-size: 20rpx; }
.field-error { display: block; margin-top: 10rpx; color: #c43b44; font-size: 21rpx; line-height: 1.5; }
.privacy-note { display: flex; align-items: flex-start; gap: 13rpx; margin-bottom: 24rpx; color: #66748a; font-size: 21rpx; line-height: 1.6; }
.privacy-icon { width: 32rpx; height: 32rpx; flex: 0 0 auto; margin-top: 2rpx; }
.submit-button { height: 104rpx; display: flex; align-items: center; justify-content: center; border-radius: 24rpx; color: #fff; background: #123a70; box-shadow: 0 16rpx 40rpx rgba(18,58,112,.2); font-size: 32rpx; font-weight: 800; }
.submit-button.disabled { color: #8b96a7; background: #e5e9ef; box-shadow: none; }
.home-button:active, .submit-button:not(.disabled):active, .info-fab:active, .call-button:active, .modal-close:active { opacity: .82; }
.legal-footer { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 10rpx; padding: 32rpx 12rpx 0; color: #66748a; font-size: 21rpx; line-height: 1.6; text-align: center; }
.legal-link { min-height: 88rpx; display: inline-flex; align-items: center; padding: 0 8rpx; color: #123a70; font-weight: 800; }
.legal-separator { color: #a7b0be; }
.info-fab { position: fixed; z-index: 50; right: 32rpx; bottom: calc(180rpx + env(safe-area-inset-bottom)); box-sizing: border-box; width: 88rpx !important; min-width: 88rpx !important; max-width: 88rpx !important; height: 88rpx !important; display: flex; align-items: center; justify-content: center; padding: 0; border: 1rpx solid rgba(255,255,255,.7); border-radius: 50%; background-color: #123a70; box-shadow: 0 16rpx 40rpx rgba(18,58,112,.27); overflow: hidden; }
.info-fab image { width: 44rpx; height: 44rpx; }
.contact-modal { position: fixed; z-index: 200; inset: 0; display: flex; align-items: center; justify-content: center; box-sizing: border-box; padding: calc(40rpx + env(safe-area-inset-top)) 32rpx calc(40rpx + env(safe-area-inset-bottom)); background: rgba(15,29,49,.58); }
.contact-modal-card { width: 100%; max-width: 686rpx; box-sizing: border-box; max-height: calc(100vh - 160rpx); overflow-y: auto; padding: 34rpx 32rpx 38rpx; border-radius: 36rpx; background: #fff; box-shadow: 0 40rpx 120rpx rgba(8,25,48,.3); animation: modal-in 220ms cubic-bezier(.2,.8,.2,1); }
@keyframes modal-in { from { opacity: 0; transform: translateY(20rpx); } to { opacity: 1; transform: translateY(0); } }
.modal-head { display: flex; align-items: center; justify-content: space-between; gap: 24rpx; }
.modal-title { color: #172338; font-size: 40rpx; font-weight: 800; }
.modal-close { width: 88rpx; min-width: 88rpx; height: 88rpx; display: flex; align-items: center; justify-content: center; flex: 0 0 auto; background: transparent; }
.modal-close image { width: 30rpx; height: 30rpx; }
.contact-modal-content { display: flex; align-items: flex-start; gap: 28rpx; margin-top: 28rpx; }
.contact-details { flex: 1; min-width: 0; }
.qr-wrap { flex: 0 0 auto; width: 230rpx; }
.contact-label, .contact-phone, .service-hours { display: block; }
.contact-label { color: #66748a; font-size: 24rpx; }
.contact-phone { margin-top: 10rpx; color: #172338; font-size: 40rpx; font-weight: 800; white-space: nowrap; }
.service-hours { margin-top: 18rpx; color: #66748a; font-size: 24rpx; line-height: 1.65; white-space: pre-line; }
.call-button { min-width: 176rpx; height: 88rpx; display: inline-flex; align-items: center; justify-content: center; box-sizing: border-box; gap: 12rpx; margin-top: 24rpx; padding: 0 32rpx; border: 1rpx solid #bfd2ea; border-radius: 22rpx; color: #123a70; background: #eaf2ff; font-size: 26rpx; font-weight: 800; }
.call-button image { width: 34rpx; height: 34rpx; }
.qr-wrap { padding: 12rpx; border: 1rpx solid #dfe6ef; border-radius: 28rpx; background: #fff; text-align: center; }
.contact-qr { width: 206rpx; height: 218rpx; display: block; margin: 0 auto; }
.qr-wrap text { display: block; margin-top: 10rpx; color: #66748a; font-size: 20rpx; line-height: 1.45; }
