page {
  min-height: 100%;
  overflow-x: hidden;
  color: #172338;
  background: #f4f7fb;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

button,
button[type="default"],
button[type="primary"],
button[type="warn"] {
  box-sizing: border-box;
  min-width: 0;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  color: inherit;
  background-color: transparent;
  background-image: none;
  font-size: inherit;
  line-height: normal;
  -webkit-tap-highlight-color: transparent;
}
button::after,
button::before {
  display: none;
  border: none;
  background: transparent;
}
button[disabled] { color: inherit; background-color: transparent; }
button.button-hover { background-color: transparent; }

/* ===== 顶部品牌栏（首页 / 办理记录 / 联系客服 三个 Tab 页共用，对齐设计稿） ===== */
.topbar { position: sticky; z-index: 30; top: 0; padding-bottom: 8rpx; border-bottom: 1rpx solid rgba(223,230,239,.82); background: rgba(255,255,255,.98); }
.brand-row { display: flex; box-sizing: border-box; height: 120rpx; align-items: center; justify-content: space-between; gap: 20rpx; padding-left: 36rpx; }
.brand-lockup { display: flex; min-width: 0; align-items: center; gap: 18rpx; }
.brand-mark { width: 76rpx; height: 76rpx; display: flex; flex: 0 0 auto; align-items: center; justify-content: center; border-radius: 24rpx; color: #fff; background: linear-gradient(145deg, #184d91, #2b78c5); box-shadow: 0 14rpx 36rpx rgba(18,58,112,.2); font-size: 30rpx; font-weight: 800; }
.brand-icon { width: 44rpx; height: 44rpx; }
.brand-name, .brand-caption { display: block; }
.brand-name { color: #172338; font-size: 36rpx; font-weight: 800; }
.brand-caption { margin-top: 4rpx; color: #66748a; font-size: 24rpx; }
.secure-pill { min-height: 88rpx; display: flex; flex: 0 0 auto; align-items: center; gap: 10rpx; padding: 0 20rpx; border: 1rpx solid #cdebe5; border-radius: 999rpx; color: #087262; background: #f1fbf8; font-size: 24rpx; font-weight: 700; }
.secure-icon { width: 30rpx; height: 30rpx; }
