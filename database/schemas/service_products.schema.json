{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "service_products",
  "type": "object",
  "required": ["name", "service_type", "package_key", "price_cents", "status", "created_at", "updated_at"],
  "properties": {
    "name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "service_type": { "enum": ["annual", "tax", "invoice", "license"] },
    "package_key": { "enum": ["basic", "plus", "full"] },
    "price_cents": { "type": "integer", "minimum": 1, "maximum": 100000000 },
    "description": { "type": "string", "maxLength": 500 },
    "status": { "enum": ["active", "inactive"] },
    "is_test_price": { "type": "boolean" },
    "created_at": { "type": ["object", "string"] },
    "updated_at": { "type": ["object", "string"] }
  }
}
